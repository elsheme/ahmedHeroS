@model AhmedHeroWedding.Models.WeddingPageViewModel

<div class="duaa-counter-banner reveal-on-scroll">
    <div class="duaa-banner-title">«&nbsp;بارك الله لهما وبارك عليهما وجمع بينهما في&nbsp;خير&nbsp;»</div>
    <div class="duaa-banner-subtitle">@Model.Config.Ui.DuaSubtitle</div>
    
    <div class="duaa-count-callout">
        <span id="duaa-counter-number">@AhmedHeroWedding.Services.WeddingDataService.ToEasternArabicDigits(Model.PrayerCount)</span>
        <span class="duaa-count-label">@Model.Config.Ui.DuaCountLabel</span>
    </div>

    <button id="duaa-pray-btn" type="button" class="duaa-pray-btn" aria-label="@Model.Config.Ui.DuaBtn">
        <span class="duaa-btn-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
        </span>
        <span class="duaa-btn-text">@Model.Config.Ui.DuaBtn</span>
    </button>
</div>
