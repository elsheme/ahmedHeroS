@model AhmedHeroWedding.Models.WeddingPageViewModel
@{
    var shareText = Uri.EscapeDataString($"يسعدنا ويشرفنا دعوتكم لحضور عقد قران {Model.Couple.GroomName} & {Model.Couple.BrideName} يوم {Model.Event.DayName} {Model.Event.FormattedDate} ({Model.Event.FormattedHijriDate}) في {Model.Event.HallName} – {Model.Event.HotelName}. حضوركم يكمل بركة عقدنا!\nرابط الدعوة: {Context.Request.Scheme}://{Context.Request.Host}");
    var whatsappShareUrl = $"https://api.whatsapp.com/send?text={shareText}";
}

<section id="finale" class="section-finale-emerald">
    <div class="finale-card-composition reveal-on-scroll">
        <div class="finale-monogram-seal">
            <svg viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="46" fill="none" stroke="#E8D3A0" stroke-width="1.2" stroke-dasharray="3, 2" />
                <circle cx="50" cy="50" r="41" fill="none" stroke="#E8D3A0" stroke-width="1.4" />
                <circle cx="50" cy="9" r="2.5" fill="#E8D3A0" />
                <circle cx="50" cy="91" r="2.5" fill="#E8D3A0" />
                <circle cx="9" cy="50" r="2.5" fill="#E8D3A0" />
                <circle cx="91" cy="50" r="2.5" fill="#E8D3A0" />
            </svg>
            <span class="finale-monogram-text">@Model.Couple.MonogramText</span>
        </div>

        <div class="finale-blessing-calligraphy">
            «&nbsp;بارك الله لهما وبارك عليهما وجمع بينهما في&nbsp;خير&nbsp;»
        </div>

        <p class="finale-subtext">
            جزاكم الله خيراً على حضوركم ودعائكم
        </p>

        <a href="@whatsappShareUrl" target="_blank" rel="noopener noreferrer" class="btn-luxury-gold finale-share-btn">
            <svg class="svg-icon" style="width: 22px; height: 22px; fill: currentColor; stroke: none; flex-shrink: 0;" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.996.586 3.864 1.6 5.441L2.2 22l4.686-1.371a10.01 10.01 0 0 0 5.145 1.402h.004c5.536 0 10.031-4.495 10.031-10.031S17.567 2 12.031 2zm0 18.337a8.318 8.318 0 0 1-4.243-1.161l-.304-.18-3.155.923.931-3.076-.197-.315a8.297 8.297 0 0 1-1.272-4.497c0-4.604 3.746-8.35 8.35-8.35 4.604 0 8.35 3.746 8.35 8.35 0 4.604-3.746 8.35-8.35 8.35zm4.577-6.248c-.251-.126-1.485-.733-1.716-.817-.23-.084-.397-.126-.564.126-.167.251-.649.817-.795.985-.147.167-.293.189-.544.063s-1.06-.391-2.019-1.246c-.746-.665-1.25-1.487-1.396-1.738-.147-.251-.016-.387.11-.512.113-.113.251-.293.377-.44.126-.147.167-.251.251-.418.084-.167.042-.314-.021-.44-.063-.126-.564-1.36-.774-1.862-.204-.49-.411-.423-.564-.431l-.481-.008c-.167 0-.44.063-.67.314-.23.251-.879.859-.879 2.094s.9 2.429 1.026 2.597c.126.167 1.77 2.703 4.288 3.79.599.259 1.067.414 1.432.53.602.191 1.15.164 1.583.099.483-.072 1.485-.607 1.694-1.193.209-.586.209-1.088.147-1.193-.063-.105-.23-.167-.481-.293z"/>
            </svg>
            <span>شارك الدعوة</span>
        </a>

        <button type="button" id="replay-intro-btn" class="finale-replay-link" aria-label="إعادة فتح الدعوة">
            <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            <span>إعادة فتح الدعوة</span>
        </button>

        <div class="finale-signoff-names">
            @Model.Couple.GroomName &amp; @Model.Couple.BrideName
        </div>
        <div class="finale-signoff-date">
            @Model.Event.DayName @Model.Event.FormattedDate
        </div>
        <div class="finale-signoff-hijri">
            الموافق @Model.Event.FormattedHijriDate
        </div>
    </div>
</section>
