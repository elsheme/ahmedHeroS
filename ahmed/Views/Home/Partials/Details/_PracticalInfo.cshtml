@model AhmedHeroWedding.Models.WeddingPageViewModel

<div class="practical-info-block reveal-on-scroll">
    <div class="practical-info-header">
        <h3 class="practical-block-title">@Model.Config.Ui.PracticalInfoHeading</h3>
        <div class="practical-title-gold-bar" aria-hidden="true"></div>
    </div>

    <div class="practical-info-list">
        <!-- 1. توقيت مراسم العقد -->
        <div class="practical-info-row">
            <div class="practical-row-head">
                <svg class="practical-icon-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A24B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span class="practical-row-title">توقيت مراسم العقد</span>
            </div>
            <p class="practical-row-text">@Model.Config.DetailsBlock.PrayerTiming</p>
        </div>

        <div class="practical-hairline-sep" aria-hidden="true"></div>

        <!-- 2. خدمة صف السيارات -->
        <div class="practical-info-row">
            <div class="practical-row-head">
                <svg class="practical-icon-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A24B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span class="practical-row-title">خدمة صف السيارات</span>
            </div>
            <p class="practical-row-text">@Model.Config.DetailsBlock.ParkingNote</p>
        </div>

        <div class="practical-hairline-sep" aria-hidden="true"></div>

        <!-- 3. الزي المقترح -->
        <div class="practical-info-row">
            <div class="practical-row-head">
                <svg class="practical-icon-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A24B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
                </svg>
                <span class="practical-row-title">الزي المقترح</span>
            </div>
            <p class="practical-row-text">@Model.Config.DetailsBlock.DressCode</p>
        </div>

        <div class="practical-hairline-sep" aria-hidden="true"></div>

        <!-- 4. للاستفسار والتنسيق -->
        <div class="practical-info-row">
            <div class="practical-row-head">
                <svg class="practical-icon-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A24B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span class="practical-row-title">للاستفسار والتنسيق</span>
            </div>
            <p class="practical-row-text">لأي استفسار بخصوص موقع القاعة أو المراسم:</p>
            <div class="practical-contact-actions">
                <a href="tel:@Model.Config.DetailsBlock.CoordinatorContactPhone" class="btn-practical-call">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <span>اتصال</span>
                </a>
                <a href="@Model.Config.DetailsBlock.WhatsAppDirectUrl" target="_blank" rel="noopener noreferrer" class="btn-practical-whatsapp">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                        <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.996.586 3.864 1.6 5.441L2.2 22l4.686-1.371a10.01 10.01 0 0 0 5.145 1.402h.004c5.536 0 10.031-4.495 10.031-10.031S17.567 2 12.031 2zm0 18.337a8.318 8.318 0 0 1-4.243-1.161l-.304-.18-3.155.923.931-3.076-.197-.315a8.297 8.297 0 0 1-1.272-4.497c0-4.604 3.746-8.35 8.35-8.35 4.604 0 8.35 3.746 8.35 8.35 0 4.604-3.746 8.35-8.35 8.35zm4.577-6.248c-.251-.126-1.485-.733-1.716-.817-.23-.084-.397-.126-.564.126-.167.251-.649.817-.795.985-.147.167-.293.189-.544.063s-1.06-.391-2.019-1.246c-.746-.665-1.25-1.487-1.396-1.738-.147-.251-.016-.387.11-.512.113-.113.251-.293.377-.44.126-.147.167-.251.251-.418.084-.167.042-.314-.021-.44-.063-.126-.564-1.36-.774-1.862-.204-.49-.411-.423-.564-.431l-.481-.008c-.167 0-.44.063-.67.314-.23.251-.879.859-.879 2.094s.9 2.429 1.026 2.597c.126.167 1.77 2.703 4.288 3.79.599.259 1.067.414 1.432.53.602.191 1.15.164 1.583.099.483-.072 1.485-.607 1.694-1.193.209-.586.209-1.088.147-1.193-.063-.105-.23-.167-.481-.293z"/>
                    </svg>
                    <span>واتساب المنسق</span>
                </a>
            </div>
        </div>
    </div>
</div>
