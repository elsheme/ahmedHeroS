@model AhmedHeroWedding.Models.WeddingPageViewModel

<div class="styled-map-frame reveal-on-scroll">
    <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3454.218820612457!2d31.42875147555325!3d30.03058447493035!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14583cbfb1ad69bf%3A0x6739d48fc1a0840!2sAl%20Masa%20Hotel%20Nasr%20City!5e0!3m2!1sar!2seg!4v1714500000000!5m2!1sar!2seg" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="موقع قاعة اللؤلؤة - فندق الماسة"
        aria-hidden="true">
    </iframe>

    <!-- Overlay link covering the whole map to prevent scroll trap and open maps in a new tab -->
    <a href="@Model.Event.GoogleMapsUrl" target="_blank" rel="noopener noreferrer" class="map-overlay-link" aria-label="@Model.Config.Ui.OpenMapTag">
        <span class="map-location-tag">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>@Model.Config.Ui.OpenMapTag</span>
        </span>
    </a>
</div>
