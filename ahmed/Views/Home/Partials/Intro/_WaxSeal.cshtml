@model AhmedHeroWedding.Models.WeddingPageViewModel
@* Royal Wax Seal with Botanical Rose Bud & Blooming Petals *@
<div id="wax-seal" class="wax-seal" role="button" aria-label="كسر الختم وفك العقد">
    <div id="seal-rose-bloom" class="seal-rose-bloom-container" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="botanical-rose-svg">
            <defs>
                <linearGradient id="roseGoldLine" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#E8D3A0"/>
                    <stop offset="50%" stop-color="#C9A24B"/>
                    <stop offset="100%" stop-color="#8A6A22"/>
                </linearGradient>
                <radialGradient id="rosePetalGrad" cx="45%" cy="38%" r="60%">
                    <stop offset="0%" stop-color="#FFF0F3"/>
                    <stop offset="38%" stop-color="#F8B4C0"/>
                    <stop offset="75%" stop-color="#EC8FA0"/>
                    <stop offset="100%" stop-color="#D96E82"/>
                </radialGradient>
                <radialGradient id="roseMidPetalGrad" cx="50%" cy="40%" r="55%">
                    <stop offset="0%" stop-color="#FFF5F7"/>
                    <stop offset="50%" stop-color="#F4A2B2"/>
                    <stop offset="100%" stop-color="#E06C82"/>
                </radialGradient>
                <radialGradient id="roseInnerCoreGrad" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#FFE8ED"/>
                    <stop offset="100%" stop-color="#D96E82"/>
                </radialGradient>
                <radialGradient id="roseSepalGrad" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="rgba(232, 211, 160, 0.6)"/>
                    <stop offset="100%" stop-color="rgba(11, 46, 42, 0.35)"/>
                </radialGradient>
            </defs>
            <g class="rose-sepals">
                <path class="rose-sepal sepal-left" d="M48,64 C40,68 30,76 22,80 C30,72 40,68 48,64 Z" fill="url(#roseSepalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
                <path class="rose-sepal sepal-right" d="M52,64 C60,68 70,76 78,80 C70,72 60,68 52,64 Z" fill="url(#roseSepalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
                <path class="rose-sepal sepal-bottom" d="M50,65 C48,76 47,88 50,96 C53,88 52,76 50,65 Z" fill="url(#roseSepalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
            </g>
            <g class="rose-petals-outer">
                <path class="rose-petal petal-outer petal-1" d="M50,48 C32,24 16,38 18,54 C20,66 36,70 50,65 C38,60 28,52 30,44 C32,36 42,38 50,48 Z" fill="url(#rosePetalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
                <path class="rose-petal petal-outer petal-2" d="M50,48 C68,24 84,38 82,54 C80,66 64,70 50,65 C62,60 72,52 70,44 C68,36 58,38 50,48 Z" fill="url(#rosePetalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
                <path class="rose-petal petal-outer petal-3" d="M50,46 C34,16 66,16 50,46 C40,24 60,24 50,46 Z" fill="url(#rosePetalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
            </g>
            <g class="rose-petals-mid">
                <path class="rose-petal petal-mid petal-4" d="M50,52 C36,34 26,46 34,58 C40,64 48,62 50,58 Z" fill="url(#roseMidPetalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
                <path class="rose-petal petal-mid petal-5" d="M50,52 C64,34 74,46 66,58 C60,64 52,62 50,58 Z" fill="url(#roseMidPetalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
            </g>
            <g class="rose-petals-inner">
                <path class="rose-petal petal-inner petal-6" d="M50,54 C42,40 58,40 50,54 Z" fill="url(#roseMidPetalGrad)" stroke="url(#roseGoldLine)" stroke-width="1.3"/>
                <path class="rose-petal petal-core" d="M46,50 C45,46 55,45 54,49 C53,52 47,53 46,50 Z" fill="url(#roseInnerCoreGrad)" stroke="url(#roseGoldLine)" stroke-width="1.4"/>
            </g>
        </svg>
    </div>
    <div class="wax-seal-outer-rim"></div>
    <div class="wax-seal-inner">
        <span class="wax-seal-monogram">@Model.Couple.MonogramText</span>
    </div>
    <div class="wax-seal-shimmer"></div>
</div>
