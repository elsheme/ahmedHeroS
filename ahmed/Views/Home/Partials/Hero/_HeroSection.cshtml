@model AhmedHeroWedding.Models.WeddingPageViewModel

<section id="hero" class="hero-full-viewport">
    <div class="hero-arch-composition reveal-on-scroll">
        <div class="hero-pattern-watermark" aria-hidden="true"></div>

        <partial name="Partials/Hero/_HeroVines" />

        <div class="hero-rose-top-crown" aria-hidden="true">
            <svg viewBox="0 0 140 38" style="width: 100%; height: 100%;">
                <path d="M 10,24 C 40,14 60,26 70,16 C 80,26 100,14 130,24" fill="none" stroke="#C9A24B" stroke-width="1.2" stroke-linecap="round"/>
                <g transform="translate(56, 2) scale(0.28)">
                    <circle cx="50" cy="50" r="28" fill="rgba(255,242,245,0.96)" stroke="#C9A24B" stroke-width="1.4"/>
                    <path d="M 34,50 C 34,40 66,40 66,50 C 66,60 34,60 34,50 Z" fill="rgba(244,162,176,0.72)" stroke="#C9A24B" stroke-width="1.2"/>
                </g>
            </svg>
        </div>

        <partial name="Partials/Hero/_GuestGreeting" model="Model" />

        <div class="hero-emblem-seal">
            <svg viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="46" fill="none" stroke="#C9A24B" stroke-width="1.2" stroke-dasharray="3, 2" />
                <circle cx="50" cy="50" r="41" fill="none" stroke="#C9A24B" stroke-width="1.4" />
                <circle cx="50" cy="9" r="2.5" fill="#C9A24B" />
                <circle cx="50" cy="91" r="2.5" fill="#C9A24B" />
                <circle cx="9" cy="50" r="2.5" fill="#C9A24B" />
                <circle cx="91" cy="50" r="2.5" fill="#C9A24B" />
                <circle cx="21" cy="21" r="2" fill="#C9A24B" />
                <circle cx="79" cy="79" r="2" fill="#C9A24B" />
                <circle cx="21" cy="79" r="2" fill="#C9A24B" />
                <circle cx="79" cy="21" r="2" fill="#C9A24B" />
            </svg>
            <span class="hero-emblem-text">@Model.Couple.MonogramText</span>
        </div>

        <div class="hero-quran-verse font-quran">
            &#64831; @Model.Couple.QuranVerse &#64830;
        </div>

        <partial name="Partials/_HairlineGoldDivider" />

        <p class="hero-lead-invitation">
            @Model.Couple.InvitationText
        </p>

        <partial name="Partials/Hero/_HeroNames" model="Model" />
        <partial name="Partials/Hero/_HeroDate" model="Model" />

        <div class="hero-scroll-cue" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A24B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
    </div>
</section>
